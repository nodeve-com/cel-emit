input.options.map(row, Row{
  origin: input.locations.filter(l, l.id == row.legs[0].location.id)[0].locode,
  dest: input.locations.filter(l, l.id == row.legs[0].end_location.id)[0].locode,
  depart_utc: to_utc(row.start_date + "T" + row.start_time, row.timezone),
  arrive_utc: to_utc(row.end_date + "T" + row.end_time, input.locations.filter(l, l.id == row.legs[0].end_location.id)[0].timezone),
  depart_local: row.start_date + "T" + row.start_time,
  arrive_local: row.end_date + "T" + row.end_time,
  fare: input.products.filter(p, p.id == row.product_id)[0].title,
  vessel: has(row.venue) ? row.venue.title : null,
  currency: input.currency,
  total_minor: row.pricing.total,
  best_total_minor: row.pricing_potential_best != null ? row.pricing_potential_best.total : null,
  duration_min: (to_utc(row.end_date + "T" + row.end_time, input.locations.filter(l, l.id == row.legs[0].end_location.id)[0].timezone) - to_utc(row.start_date + "T" + row.start_time, row.timezone)).getMinutes(),
  active_period_min: iso_duration(input.products.filter(p, p.id == row.product_id && p.multi_usage_rules.active_period.type == "period")[0].multi_usage_rules.active_period.period).getMinutes(),
  seats_available: row.capacities.available,
  bookable: row.status == "available",
})
